# URL style basemap. Produksi: style MAPID MAPS (lihat dokumentasi panitia pasca-kurasi).
# Kosongkan untuk memakai basemap default dev: raster OpenStreetMap (style lokal).
PUBLIC_BASEMAP_STYLE_URL=

# Base URL API (Cloudflare Workers). Kosongkan untuk default dev http://localhost:8787
PUBLIC_API_BASE_URL=

# Site key Cloudflare Turnstile (widget verifikasi pesan pertama chat).
# Kosongkan di dev untuk melewati verifikasi (API juga butuh TURNSTILE_DEV_BYPASS=1).
PUBLIC_TURNSTILE_SITE_KEY=

# API Key MAPID Activities / Mission (default: key tim #Devunder)
PUBLIC_MAPID_API_KEY=6a919d9453df37905b3a5d49

