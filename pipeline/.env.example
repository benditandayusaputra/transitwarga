# Salin ke pipeline/.env (gitignored). File .example ini aman di-push
# (semua nilai placeholder).

# --- PostgreSQL opsional (make load-db) -------------------------------------
DATABASE_URL=postgres://user:password@127.0.0.1:5432/transitwarga?sslmode=disable

# --- Vision batch (02_vision.py, via LiteLLM) -------------------------------
# Model vision bebas provider — format nama model mengikuti LiteLLM.
# Tanpa key, jalankan `make build-data VISION=mock` (default).
#
# Gemini:
# VISION_MODEL=gemini/gemini-2.5-flash
# VISION_API_KEY=AIzaXXXXXXXXXXXXXXXXX
#
# OpenAI:
# VISION_MODEL=gpt-5-mini
# VISION_API_KEY=sk-xxxxxxxxxxxxxxxxx
#
# Anthropic (Claude):
# VISION_MODEL=anthropic/claude-haiku-4-5
# VISION_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx
#
# OpenRouter:
# VISION_MODEL=openrouter/google/gemini-2.5-flash
# VISION_API_KEY=sk-or-xxxxxxxxxxxxxxxxx
